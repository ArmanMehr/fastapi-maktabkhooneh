# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# For SQLite (development only): sqlite:///./test.db
DATABASE_URL=postgresql://user:pass@localhost:5432/maktabkhooneh

# ============================================
# JWT & Authentication Configuration
# ============================================
# Secret key for JWT token signing
# IMPORTANT: Change this to a strong random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production

# Access token lifetime in seconds (default: 300 = 5 minutes)
JWT_ACCESS_TOKEN_DUR=300

# Refresh token lifetime in seconds (default: 25200 = 7 hours)
JWT_REFRESH_TOKEN_DUR=25200

# Use secure cookies (HTTPS only)
# Set to True in production, False for local development
AUTH_COOKIE_SECURE=False

# ============================================
# Redis Cache Configuration
# ============================================
# Redis connection URL
# Local: redis://localhost:6379
# With password: redis://:password@localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Internationalization Configuration
# ============================================
# Supported language codes (comma-separated or JSON format)
SUPPORTED_LANGUAGES=["fa", "en"]

# Default language code
DEFAULT_LANGUAGE=en

# ============================================
# Error Tracking Configuration (Optional)
# ============================================
# Sentry DSN for error tracking and monitoring
# Leave empty to disable Sentry
# Get your DSN from: https://sentry.io/
SENTRY_DSN=
